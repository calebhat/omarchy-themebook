#!/bin/bash
# Override or restore Appearance > Theme in the user menu extension.
# Omarchy 4.5 renamed Style to Appearance (id appearance.theme, alias style).
# This file only holds overrides, so removing appearance.theme restores the carousel.

set -euo pipefail

MENU=$HOME/.config/omarchy/extensions/omarchy-menu.jsonc
mkdir -p "$(dirname "$MENU")"
# Fall back to Omarchy's picker if ThemeBook is disabled or gone, so a leftover
# override cannot break Appearance > Theme / Super+Ctrl+T.
ENTRY='  "appearance.theme": {"icon":"󰸌","label":"Theme","aliases":["theme","themes"],"action":"omarchy-shell themebook pick || omarchy-shell shell summon omarchy.image-picker '"'"'{\"source\":\"themes\"}'"'"'"}'

strip_theme_override() {
  python3 - "$MENU" <<'PY'
import pathlib, sys
path = pathlib.Path(sys.argv[1])
if not path.exists():
    raise SystemExit(0)
lines = path.read_text().splitlines(True)
out = []
for line in lines:
    stripped = line.lstrip()
    if stripped.startswith('"style.theme"') or stripped.startswith('"appearance.theme"'):
        continue
    if stripped.startswith('"style.themebook"'):
        out.append(line.replace('"style.themebook"', '"appearance.themebook"', 1))
        continue
    out.append(line)
text = "".join(out).replace(",\n}", "\n}")
path.write_text(text)
PY
}

insert_theme_override() {
  python3 - "$MENU" "$ENTRY" <<'PY'
import pathlib, sys
path = pathlib.Path(sys.argv[1])
entry = sys.argv[2]
text = path.read_text() if path.exists() else "{\n}\n"
idx = text.rfind("}")
if idx < 0:
    path.write_text("{\n" + entry + "\n}\n")
    raise SystemExit(0)
before = text[:idx].rstrip()
if before.endswith("{") or before.endswith(","):
    inserted = before + "\n" + entry + "\n"
else:
    inserted = before + ",\n" + entry + "\n"
path.write_text(inserted + text[idx:])
PY
}

case ${1:-} in
  replace)
    strip_theme_override
    insert_theme_override
    ;;
  restore)
    strip_theme_override
    ;;
  *)
    echo "Usage: set-default-picker replace|restore" >&2
    exit 1
    ;;
esac
