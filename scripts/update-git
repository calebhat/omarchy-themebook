#!/bin/bash
# Compare local HEAD to origin for user-installed git themes.
# JSON lines on stdout for a progress overlay.
# Never pull, merge, reset, or checkout: fetched objects stay in .git.
# Same extras rule as omarchy-theme-extras: real dirs with a .git directory.

set -euo pipefail

if [[ ${THEMEBOOK_UPDATE_WRAPPED:-0} != 1 ]] && command -v stdbuf >/dev/null 2>&1; then
  export THEMEBOOK_UPDATE_WRAPPED=1
  exec stdbuf -oL -eL /bin/bash "$0" "$@"
fi

export GIT_TERMINAL_PROMPT=0
MAX_THEMES=256
MAX_DETAIL=240
USER_THEMES=$HOME/.config/omarchy/themes

GIT_SAFE=(
  -c core.hooksPath=/dev/null
  -c fetch.recurseSubmodules=false
  -c transfer.fsckObjects=true
)

git_safe() {
  git "${GIT_SAFE[@]}" "$@"
}

fetch_origin() {
  local theme=$1
  if command -v timeout >/dev/null 2>&1; then
    timeout --signal=TERM --kill-after=2s 45s git "${GIT_SAFE[@]}" -C "$theme" fetch --no-tags --recurse-submodules=no -- origin
  else
    git_safe -C "$theme" fetch --no-tags --recurse-submodules=no -- origin
  fi
}

origin_ok() {
  local url=$1
  [[ -n $url && $url != *$'\n'* && $url != *$'\r'* ]] || return 1
  [[ $url != -* ]] || return 1
  [[ $url != *::* ]] || return 1
  if [[ $url =~ ^([A-Za-z0-9][A-Za-z0-9+.-]*):// ]]; then
    local scheme=${BASH_REMATCH[1]}
    [[ $scheme == ssh || $scheme == git || $scheme == git+ssh || $scheme == ssh+git || $scheme == http || $scheme == https ]]
    return
  fi
  return 0
}

title_case() {
  sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g' <<<"$1"
}

emit() {
  jq -cn "$@"
}

emit_start() {
  emit --argjson total "$1" '{event:"start",total:$total}'
}

emit_done() {
  emit '{event:"done"}'
}

emit_theme() {
  local slug=$1 status=$2 detail=$3
  emit --arg slug "$slug" --arg name "$(title_case "$slug")" --arg status "$status" --arg detail "$detail" \
    '{event:"theme",slug:$slug,name:$name,status:$status,detail:$detail}'
}

clip() {
  local s=$1
  s=${s//$'\r'/ }
  s=$(tr -cd '\11\12\40-\176' <<<"$s" | tr '\n' ' ')
  s=${s##+([[:space:]])}
  s=${s%%+([[:space:]])}
  if (( ${#s} > MAX_DETAIL )); then
    s=${s:0:MAX_DETAIL}
  fi
  printf '%s' "$s"
}

short_sha() {
  local sha=$1
  printf '%s' "${sha:0:12}"
}

shopt -s extglob

if [[ ! -d $USER_THEMES ]]; then
  emit_start 0
  emit_done
  exit 0
fi

themes=()
for theme in "$USER_THEMES"/*; do
  [[ -d $theme && ! -L $theme && -d $theme/.git ]] || continue
  slug=${theme##*/}
  [[ $slug =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && $slug != *..* ]] || continue
  themes+=("$theme")
  (( ${#themes[@]} < MAX_THEMES )) || break
done

emit_start ${#themes[@]}
if (( ${#themes[@]} == 0 )); then
  emit_done
  exit 0
fi

failed=0
for theme in "${themes[@]}"; do
  slug=${theme##*/}
  emit_theme "$slug" checking ""
  url=""
  url=$(git_safe -C "$theme" remote get-url origin 2>/dev/null) || url=""
  if ! origin_ok "$url"; then
    failed=1
    emit_theme "$slug" failed "origin URL is not a git repository"
    continue
  fi
  local_sha=""
  local_sha=$(git_safe -C "$theme" rev-parse HEAD 2>/dev/null) || local_sha=""
  if [[ ! $local_sha =~ ^[0-9a-f]{40}$ ]]; then
    failed=1
    emit_theme "$slug" failed "no local HEAD"
    continue
  fi
  if ! git_safe -C "$theme" rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1; then
    failed=1
    emit_theme "$slug" failed "no upstream branch"
    continue
  fi
  st=0
  out=""
  out=$(fetch_origin "$theme" 2>&1) || st=$?
  if (( st == 124 || st == 137 )); then
    failed=1
    emit_theme "$slug" failed "timed out"
    continue
  fi
  if (( st != 0 )); then
    failed=1
    detail=$(clip "$out")
    emit_theme "$slug" failed "${detail:-git fetch failed}"
    continue
  fi
  remote_sha=""
  remote_sha=$(git_safe -C "$theme" rev-parse '@{upstream}' 2>/dev/null) || remote_sha=""
  if [[ ! $remote_sha =~ ^[0-9a-f]{40}$ ]]; then
    failed=1
    emit_theme "$slug" failed "no upstream SHA"
    continue
  fi
  if [[ $local_sha == "$remote_sha" ]]; then
    emit_theme "$slug" current "HEAD $(short_sha "$local_sha")"
  else
    emit_theme "$slug" available "HEAD $(short_sha "$local_sha") origin $(short_sha "$remote_sha")"
  fi
done

emit_done
exit "$failed"
