#!/bin/bash
# Read or atomically write ThemeBook config JSON.

set -euo pipefail

CONFIG_DIR=$HOME/.config/omarchy
CONFIG=$CONFIG_DIR/themebook.json

mkdir -p "$CONFIG_DIR"

case ${1:-} in
  path)
    printf '%s\n' "$CONFIG"
    ;;
  read)
    if [[ -f $CONFIG ]]; then
      cat "$CONFIG"
    else
      printf '%s\n' '{}'
    fi
    ;;
  write)
    json=${2-}
    if [[ -z $json ]]; then
      json=$(cat)
    fi
    # Cap the file so a huge argv/stdin cannot fill the home partition.
    if (( ${#json} > 200000 )); then
      echo "config write: JSON too large" >&2
      exit 1
    fi
    printf '%s' "$json" | jq -e 'type == "object"' >/dev/null
    tmp=$(mktemp "$CONFIG_DIR/themebook.json.XXXXXX")
    printf '%s\n' "$json" >"$tmp"
    chmod 600 "$tmp"
    mv "$tmp" "$CONFIG"
    ;;
  *)
    echo "Usage: config read|write|path [json]" >&2
    exit 1
    ;;
esac
